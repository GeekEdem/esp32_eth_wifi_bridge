CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Two OTA slots + rollback (shared layout)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../shared/partitions/4mb_ota.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# WT32-ETH01: internal EMAC + LAN8720, 50 MHz clock in on GPIO0
CONFIG_ETH_USE_ESP32_EMAC=y

# Phones send long headers in captive-portal checks
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Forwarding hot path
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ETH_IRAM_OPTIMIZATION=y
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
# Bigger A-MPDU window: more frames per air access, so the TX buffers drain
# faster under load (IDF default 6; its help recommends 9-12 for throughput)
CONFIG_ESP_WIFI_TX_BA_WIN=12

# Two web servers (setup AP on 80, home network on the management port),
# captive DNS and mDNS share the socket pool
CONFIG_LWIP_MAX_SOCKETS=16

# mDNS: mdns_register_netif() takes only slots that are not predefined, and
# by default all three (MDNS_MAX_INTERFACES) are: STA, AP, ETH. The WT32 has
# no default station or Ethernet netif (the station carries no IP stack, the
# Ethernet is the bridge's port), so those two slots go to the management
# netif (client mode) or the bridge (router and access point modes) instead.
# The AP stays predefined: the setup AP.
CONFIG_MDNS_PREDEF_NETIF_STA=n
CONFIG_MDNS_PREDEF_NETIF_ETH=n

# Own-network mode: lwIP bridge between the AP and Ethernet
CONFIG_ESP_NETIF_BRIDGE_EN=y
CONFIG_LWIP_NUM_NETIF_CLIENT_DATA=1
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16
